# ===============================================================================
# PROJECT RECIPES - Team-shared customizations
# This file is git-tracked and preserved during devcontainer upgrades.
# Add team-shared recipes here that everyone on the project should use.
# ===============================================================================

# ===============================================================================
# SETTINGS
# ===============================================================================

# Forward recipe arguments as real shell positional parameters ("$@") so that
# quoted, space-containing arguments survive intact (e.g. `just label "Flex ID"`).
set positional-arguments

# ===============================================================================
# PROJECT VARIABLES
# ===============================================================================

project := "brother_printer"
# ===============================================================================
# INFO
# ===============================================================================

# Show project information
[group('info')]
info:
    @echo "Project: {{ project }}"

# -------------------------------------------------------------------------------
# CODE QUALITY
# -------------------------------------------------------------------------------

# Run all linters
[group('quality')]
lint:
    uv run ruff check .

# Format code
[group('quality')]
format:
    uv run ruff format .

# Run pre-commit hooks on all files
[group('quality')]
precommit:
    prek run --all-files

# -------------------------------------------------------------------------------
# TESTING
# -------------------------------------------------------------------------------

# Run tests with pytest
[group('test')]
test *args:
    uv run pytest {{ args }}

# Run tests with coverage
[group('test')]
test-cov *args:
    uv run pytest --cov --cov-report=term-missing {{ args }}

# Run opt-in hardware tests against a connected PT-E920BT (issue #4)
[group('test')]
test-hardware *args:
    BROTHER_PTOUCH_DRIVER_HARDWARE=1 uv run pytest -m hardware {{ args }}

# Run non-destructive hardware checks: connectivity + status, consumes no tape (issue #27)
[group('test')]
test-connect *args:
    BROTHER_PTOUCH_DRIVER_HARDWARE=1 uv run pytest -m hardware \
      packages/brother_ptouch_driver/tests/hardware/test_connectivity.py \
      packages/brother_ptouch_driver/tests/hardware/test_status.py {{ args }}

# Run the tape-consuming hardware print matrix (issue #27)
[group('test')]
test-print *args:
    BROTHER_PTOUCH_DRIVER_HARDWARE=1 uv run pytest -m hardware \
      packages/brother_ptouch_driver/tests/hardware/test_print.py {{ args }}

# Run the entire suite including opt-in hardware tests (issue #27)
[group('test')]
test-all *args:
    BROTHER_PTOUCH_DRIVER_HARDWARE=1 uv run pytest {{ args }}

# Regenerate label PNG fixtures for hardware print tests (issue #7, #27)
[group('test')]
gen-fixtures-driver:
    uv run python packages/brother_ptouch_driver/tests/hardware/assets/generate_fixtures.py

# Run brother-ptouch-driver package tests
[group('test')]
test-driver *args:
    uv run pytest packages/brother_ptouch_driver/tests {{ args }}

# Run brother-ptouch-label package tests
[group('test')]
test-label *args:
    uv run pytest packages/brother_ptouch_label/tests {{ args }}

# Regenerate golden render fixtures for the label package (issue #9)
[group('test')]
gen-fixtures-labels:
    uv run python packages/brother_ptouch_label/tests/assets/generate_text_fixtures.py

# -------------------------------------------------------------------------------
# DEPENDENCIES
# -------------------------------------------------------------------------------

# Sync all dependencies (idempotent, fast if nothing changed)
[group('deps')]
sync:
    @if [ -f pyproject.toml ]; then uv sync --all-packages --all-extras --all-groups; fi

# Update all dependencies
[group('deps')]
update:
    uv lock --upgrade
    @just sync

# -------------------------------------------------------------------------------
# BUILD
# -------------------------------------------------------------------------------

# Clean build artifacts
[group('build')]
clean-artifacts:
    rm -rf .pytest_cache .ruff_cache .coverage htmlcov dist build *.egg-info
    find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

# -------------------------------------------------------------------------------
# CLI
# -------------------------------------------------------------------------------

alias d := discover
alias ps := printer-status
alias t := tapes
alias p := print
alias l := label

# List connected PT-E920BT printers over USB
[group('cli')]
discover *args:
    uv run brother-ptouch-driver discover "$@"

# Show live printer status (loaded tape, errors)
[group('cli')]
printer-status *args:
    uv run brother-ptouch-driver status "$@"

# List supported tape widths and printable pixel dimensions
[group('cli')]
tapes *args:
    uv run brother-ptouch-driver info tapes "$@"

# Print an image label, e.g. `just print qr.png --tape 12mm`
[group('cli')]
print *args:
    uv run brother-ptouch-driver print "$@"

# Print a text label, e.g. `just label "Hello" --tape 12mm`
[group('cli')]
label *args:
    uv run brother-ptouch-label "$@"

# -------------------------------------------------------------------------------
# SETUP
# -------------------------------------------------------------------------------

# Install libusb + udev rule and grant non-root USB access (Linux)
[group('setup')]
setup-usb *args:
    ./packaging/scripts/setup-usb.sh "$@"

# ===============================================================================
# PROJECT-SPECIFIC RECIPES
# ===============================================================================
# Uncomment and customize for your project:
# # Run the application
# [group('app')]
# run *args:
#     uv run python -m {{project}} {{args}}
# # Run database migrations (if using sidecar)
# [group('app')]
# migrate:
#     just sidecar postgres migrate
#
# # Prepare release branch (manual workflow dispatch helper)
# [group('release')]
# prepare-release version:
#     gh workflow run prepare-release.yml --ref dev -f "version={{ version }}"
#
# # Finalize and publish release (manual workflow dispatch helper)
# [group('release')]
# finalize-release version:
#     gh workflow run release.yml --ref release/{{ version }} -f "version={{ version }}" -f "release-kind=final" -f "dry-run=false"
#
# # Publish candidate release (manual workflow dispatch helper)
# [group('release')]
# publish-candidate version:
#     gh workflow run release.yml --ref release/{{ version }} -f "version={{ version }}" -f "release-kind=candidate" -f "dry-run=false"

# ===============================================================================
# VENDORED FROM DEVKIT — .devcontainer/justfile.gh @ 1.18.0
# ===============================================================================
#
# devkit defines the release-train dispatchers and the gh/git helpers ONLY in
# .devcontainer/justfile.gh, which direnv mode does not ship (the repo-root
# justfile carries just `help`, `doctor` and `with-native-libs`). The release
# WORKFLOWS are scaffolded in every mode and are mode-aware, so the train itself
# is unaffected — but its local front-end disappeared with .devcontainer/.
#
# These are thin `gh workflow run` dispatchers; they are copied verbatim so
# `just prepare-release` etc. keep working. They are now consumer-owned and will
# NOT track devkit: re-fold them by hand when devkit changes them. Tracked
# upstream as vig-os/devkit#1823 (the 1.18.0 /devkit:release-* plugin skills
# depend on these same recipes and are likewise unusable in direnv/bare mode).
#
# Refs: #60
# -------------------------------------------------------------------------------
# ALIASES
# -------------------------------------------------------------------------------

alias gh-i := gh-issues

# List open issues and PRs grouped by milestone
[group('github')]
gh-issues:
    #!/usr/bin/env bash
    gh-issues

# -------------------------------------------------------------------------------
# GIT HELPERS
# -------------------------------------------------------------------------------

# Pretty one-line git log (last 20 commits)
[group('git')]
gh-log:
    git log --oneline -20

# Show current branch + list recent branches
[group('git')]
gh-branch:
    #!/usr/bin/env bash
    echo "Current: $(git branch --show-current)"
    echo ""
    echo "Recent branches:"
    git branch -a | head -15

# >>> devkit:release — excised from the scaffold when the release feature is disabled (#1656)
# -------------------------------------------------------------------------------
# RELEASE WORKFLOW DISPATCH HELPERS
# -------------------------------------------------------------------------------

# Preview the bot changelog entries the next release would synthesize (#1423)
[group('release')]
changelog-preview:
    #!/usr/bin/env bash
    set -euo pipefail
    export GITHUB_REPOSITORY_URL="${GITHUB_REPOSITORY_URL:-$(gh repo view --json url --jq .url)}"
    synthesize-bot-changelog --dry-run

# Prepare release branch for testing (step 1)
[group('release')]
prepare-release version ref="" *flags:
    #!/usr/bin/env bash
    set -euo pipefail
    # Trigger the prepare-release workflow via GitHub Actions
    # The workflow handles: validate inputs, create release branch, prepare CHANGELOG, create draft PR
    REF="{{ ref }}"
    if [ -z "$REF" ]; then
        REF="dev"
    fi
    gh workflow run prepare-release.yml --ref "$REF" -f "version={{ version }}" {{ flags }}
    echo ""
    echo "✓ Release preparation workflow triggered for version {{ version }}"
    echo "Monitor progress: gh run list --workflow prepare-release.yml"

# Prepare a hotfix release branch cut from main (patch of the latest tag on main; #1621)
[group('release')]
prepare-hotfix version ref="" *flags:
    #!/usr/bin/env bash
    set -euo pipefail
    # Trigger the prepare-hotfix workflow via GitHub Actions. The workflow
    # checks out main itself; REF only selects which copy of the workflow file
    # runs (dev by default: the file reaches main only through a normal train).
    # The workflow handles: validate version/train state, cut release/X.Y.Z from
    # main, seed an empty CHANGELOG section, create draft PR
    REF="{{ ref }}"
    if [ -z "$REF" ]; then
        REF="dev"
    fi
    gh workflow run prepare-hotfix.yml --ref "$REF" -f "version={{ version }}" {{ flags }}
    echo ""
    echo "✓ Hotfix preparation workflow triggered for version {{ version }}"
    echo "Monitor progress: gh run list --workflow prepare-hotfix.yml"

# Finalize and publish release via GitHub Actions workflow (step 3, after testing)
[group('release')]
finalize-release version ref="" *flags:
    #!/usr/bin/env bash
    set -euo pipefail
    # Trigger the release workflow via GitHub Actions
    # The workflow handles: finalize CHANGELOG, create final tag, publish
    REF="{{ ref }}"
    if [ -z "$REF" ]; then
        REF="release/{{ version }}"
    fi
    gh workflow run release.yml --ref "$REF" -f "version={{ version }}" -f "release-kind=final" {{ flags }}
    echo ""
    echo "✓ Release workflow triggered for version {{ version }}"
    echo "Monitor progress: gh run list --workflow release.yml"

# Promote final release: publish draft GitHub Release, merge release PR
[group('release')]
promote-release version ref="" *flags:
    #!/usr/bin/env bash
    set -euo pipefail
    REF="{{ ref }}"
    if [ -z "$REF" ]; then
        REF="release/{{ version }}"
    fi
    gh workflow run promote-release.yml --ref "$REF" -f "version={{ version }}" {{ flags }}
    echo ""
    echo "✓ Promote-release workflow triggered for version {{ version }}"
    echo "Monitor progress: gh run list --workflow promote-release.yml"

# Publish release candidate via GitHub Actions workflow
[group('release')]
publish-candidate version ref="" create-release="false" *flags:
    #!/usr/bin/env bash
    set -euo pipefail
    # Trigger release workflow in candidate mode (default mode in workflow)
    REF="{{ ref }}"
    if [ -z "$REF" ]; then
        REF="release/{{ version }}"
    fi
    gh workflow run release.yml --ref "$REF" -f "version={{ version }}" -f "release-kind=candidate" -f "create-release={{ create-release }}" {{ flags }}
    echo ""
    echo "✓ Candidate release workflow triggered for version {{ version }}"
    echo "Monitor progress: gh run list --workflow release.yml"

# Abandon a finalized-but-unpublished release: delete draft Release + tag, close PR, delete branch (draft-only, enforced server-side)
[group('release')]
abandon-release version ref="" *flags:
    #!/usr/bin/env bash
    set -euo pipefail
    # Safe only while the X.Y.Z Release is a DRAFT — the workflow hard-refuses
    # a published release (publishing tombstones the tag name permanently).
    REF="{{ ref }}"
    if [ -z "$REF" ]; then
        REF="dev"
    fi
    gh workflow run abandon-release.yml --ref "$REF" -f "version={{ version }}" {{ flags }}
    echo ""
    echo "✓ Abandon workflow triggered for version {{ version }}"
    echo "Monitor progress: gh run list --workflow abandon-release.yml"

# Reset CHANGELOG Unreleased section (after merging release to dev)
[group('release')]
reset-changelog:
    prepare-changelog reset CHANGELOG.md
# <<< devkit:release
